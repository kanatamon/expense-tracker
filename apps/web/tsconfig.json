{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      // Elysia types don't resolve transitively when imported via a
      // workspace dependency (@expense-tracker/api). This forces the
      // compiler to use the copy in this package's node_modules.
      // Safe to remove if Elysia ships proper subpath exports.
      "elysia": ["node_modules/elysia"],
      "elysia/*": ["node_modules/elysia/*"]
    }
  },
  "include": ["src"]
}
