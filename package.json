{
  "name": "expense-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api dev",
    "dev:web": "bun --cwd apps/web dev",
    "start:prod": "bun --cwd apps/web run build && bun apps/api/src/index.ts",
    "test:e2e": "playwright test",
    "test": "bun run test:api && bun run test:web",
    "test:api": "bun --cwd apps/api test",
    "test:web": "bun --cwd apps/web test",
    "typecheck": "bun run typecheck:api && bun run typecheck:web",
    "typecheck:api": "cd apps/api && bun x tsc --noEmit",
    "typecheck:web": "cd apps/web && bun x tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "elysia": "1.4.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "oxlint": "^1.62.0"
  }
}
